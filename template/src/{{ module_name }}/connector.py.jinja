{% else %}
from __future__ import annotations

from collections.abc import Sequence

from glean.indexing import BasePeopleConnector
from glean.indexing.models import EmployeeInfoDefinition

from {{ module_name }}.models import EmployeeRecord


class Connector(BasePeopleConnector[EmployeeRecord]):
    """Transforms employee records into Glean EmployeeInfoDefinitions."""

    def transform(self, data: Sequence[EmployeeRecord]) -> Sequence[EmployeeInfoDefinition]:
        """Convert employee records to Glean employee info definitions."""
        employees: list[EmployeeInfoDefinition] = []
        for record in data:
            employee = EmployeeInfoDefinition(
                email=record["email"],
                first_name=record["first_name"],
                last_name=record["last_name"],
                title=record["title"],
                department=record["department"],
                manager_email=record["manager_email"] or None,
                location=record["location"],
            )
            employees.append(employee)
        return employees
