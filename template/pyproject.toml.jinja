[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = "{{ license }}"
{% if author_name or author_email %}
authors = [
{% if author_name and author_email %}
    { name = "{{ author_name }}", email = "{{ author_email }}" },
{% elif author_name %}
    { name = "{{ author_name }}" },
{% elif author_email %}
    { email = "{{ author_email }}" },
{% endif %}
]
{% endif %}
dependencies = [
    "glean-indexing-sdk{{ sdk_range }}",
    "python-dotenv>=1.0.0",
]

[project.scripts]
{{ project_name }} = "{{ module_name }}.__main__:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ module_name }}"]

[dependency-groups]
dev = [
    "pytest",
    "pytest-cov",
    "ruff",
    "pyright",
{% if connector_category == "datasource" and datasource_type == "async_streaming" %}
    "pytest-asyncio",
{% endif %}
]

[tool.ruff]
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "I", "W", "N", "UP", "ANN"]
ignore = ["ANN401"]

[tool.pyright]
typeCheckingMode = "basic"

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]

[tool.coverage.report]
fail_under = 80
