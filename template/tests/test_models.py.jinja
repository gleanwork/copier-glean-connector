{% if connector_category == 'datasource' %}
from __future__ import annotations

from {{ module_name }}.models import SourceDocument


def test_mock_data_has_expected_count(mock_data: list[SourceDocument]) -> None:
    assert len(mock_data) == 5


def test_mock_data_has_required_fields(mock_data: list[SourceDocument]) -> None:
    required_fields = {"id", "title", "content", "author", "url", "tags", "created_at", "updated_at"}
    for record in mock_data:
        assert required_fields.issubset(record.keys())


def test_mock_data_ids_are_unique(mock_data: list[SourceDocument]) -> None:
    ids = [record["id"] for record in mock_data]
    assert len(ids) == len(set(ids))
